# PerfPilot — environment configuration template
# Copy to .env and fill in real values. Never commit .env.
# See docs/development/local-development.md and docs/security/security-model.md.

# --- Core service URLs ---
DATABASE_URL=postgresql://perfpilot:perfpilot@localhost:5432/perfpilot
REDIS_URL=redis://localhost:6379/0
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# --- Auth (MVP: single static API key; see ADR-001 for why) ---
API_AUTH_SECRET=replace-me-with-a-long-random-value

# --- AI provider abstraction (see packages/ai, ADR-004) ---
# Set AI_PROVIDER_ENABLED=true only when you explicitly want the live worker to
# call the selected provider from the API and worker. Default is offline-safe and
# deterministic, so CI and local demos continue without credentials.
AI_PROVIDER_ENABLED=false
# One of: gemini | deepseek | ollama
AI_PROVIDER=gemini
# Optional; defaults: gemini-2.5-pro, deepseek-chat, qwen3:8b
AI_PROVIDER_MODEL=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Host process: http://localhost:11434. Docker Desktop worker: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
AI_TIMEOUT_SECONDS=60
# Local inference can be slower, especially on CPU. Applies only to Ollama.
OLLAMA_TIMEOUT_SECONDS=600
AI_MAX_OUTPUT_TOKENS=2048

# Per-agent model overrides (optional — falls back to AI_PROVIDER_MODEL).
# Lets a heavier-reasoning model be assigned to the Investigator without
# changing the default for lighter-weight agents.
AI_MODEL_ORCHESTRATOR=
AI_MODEL_TEST_PLANNER=
AI_MODEL_PERFORMANCE_INVESTIGATOR=
AI_MODEL_REPORTING=

# --- k6 / Load Engineer (see infrastructure/docker, packages/metrics) ---
K6_BINARY_PATH=/usr/local/bin/k6
K6_RESULTS_DIR=./infrastructure/docker/k6/results

# --- Safety limits (see docs/security/security-model.md) ---
# Hard ceiling enforced in code, independent of what a test plan requests.
MAX_VIRTUAL_USERS=5000
MAX_TEST_DURATION_SECONDS=1800
# Comma-separated allow-list of hostnames PerfPilot is permitted to target.
ALLOWED_TARGET_HOSTS=localhost,demo.perfpilot.local

# --- Background jobs ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Observability ---
LOG_LEVEL=info
